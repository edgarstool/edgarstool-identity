# ── Supabase（身分與資料庫）──────────────────────────────
# 前端（瀏覽器）使用：Vite 於 build 時內嵌
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# 伺服器端（Cloudflare Workers / SSR / MCP）使用
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
# 僅在需要繞過 RLS 的維運作業時設定；一般部署不需要
# SUPABASE_SERVICE_ROLE_KEY="SUPABASE_SERVICE_ROLE_KEY_PLACEHOLDER"

# ── 正式網域與 OAuth / OIDC ─────────────────────────────
# 對外正式網址（不可硬編碼於程式碼）
VITE_PUBLIC_ORIGIN="https://auth.edgars.tools"
PUBLIC_ORIGIN="https://auth.edgars.tools"
# OIDC 簽發者（Issuer）：必須是直連的 Supabase Auth 主機
VITE_OIDC_ISSUER="https://<project-ref>.supabase.co/auth/v1"
MCP_OAUTH_ISSUER="https://<project-ref>.supabase.co/auth/v1"
MCP_OAUTH_AUDIENCE="authenticated"
